{
  // 수면 회복 노트 — Cloudflare Worker (화면 파일 + 같은 기록 저장)
  "name": "sleep-note",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "sleep-note", "database_id": "여기에_wrangler_d1_create_결과의_ID를_넣으세요" }
  ]
}
